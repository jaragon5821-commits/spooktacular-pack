	quests: [
		{
			description: ["&6Pipez&r moves items, fluids and energy between blocks. Pipes connect to each other and to any chest, furnace or machine they touch.", "", "Craft a handful of &eItem Pipes&r and run a line from a source chest to a destination chest. Craft a &ePipe Wrench&r too; you need it next."]
			id: "CCC786391D0CC456"
			rewards: [
				{
					id: "5F99F0DD37FF0CF3"
					item: "pipez:wrench"
					type: "item"
				}
				{
					id: "FBEB637E7F101C70"
					type: "xp"
					xp: 300
				}
			]
			size: 1.5d
			subtitle: "Your First Item Pipe"
			tasks: [{
				id: "34F4C5A39E93D364"
				item: "pipez:item_pipe"
				type: "item"
			}]
			title: "Q-WS01: Pipez: Laying the Line"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["CCC786391D0CC456"]
			description: ["A brand-new pipe will &cnot&r move anything. You have to tell it where to pull from:", "", "&e1.&r Hold the Pipe Wrench and &esneak + right-click&r the end of the pipe that touches your &osource&r chest. A colored square appears on that end: it is now extracting.", "&e2.&r Items flow out of that chest into every other inventory on the line.", "&e3.&r Sneak + right-click a connection with the wrench to disconnect it (or reconnect it) when a pipe grabs a block you didn't want."]
			icon: "pipez:wrench"
			id: "AC43ABAC3A456CC0"
			rewards: [
				{
					id: "7F0C6420F445EB5B"
					item: "pipez:basic_upgrade"
					type: "item"
				}
				{
					id: "C547CCCF210B9C5C"
					type: "xp"
					xp: 400
				}
			]
			subtitle: "Pipes Do Nothing Until They Extract"
			tasks: [{
				id: "68BAB23F633A3D59"
				title: "Pipe Set to Extract"
				type: "checkmark"
			}]
			title: "Q-WS02: Pipez: Opening the Valve"
			x: 3.0d
			y: 0.0d
		}
		{
			dependencies: ["AC43ABAC3A456CC0"]
			description: ["&eRight-click&r (not sneaking) the extracting end of a pipe to open its menu. Drop an upgrade into the slot:", "", "&6Basic&r: faster, plus &eredstone modes&r (on/off with a lever).", "&6Improved&r: adds &edistribution&r: Nearest First, Furthest First, Round Robin or Random.", "&6Advanced&r and up: adds &efilters&r. Whitelist or blacklist items, or type &e#tags&r (like #forge:ores).", "", "Want iron in one chest and food in another? Use the &eFilter Destination Tool&r: click the chest a filter should send to. &6Fluid&r and &6Energy&r pipes work the same way; the &6Universal Pipe&r carries everything."]
			icon: "pipez:advanced_upgrade"
			id: "D2773BEE220BDDEB"
			rewards: [
				{
					id: "C4C99DA5E71CBEBC"
					item: "pipez:improved_upgrade"
					type: "item"
				}
				{
					id: "37BB83834ED28747"
					item: "pipez:filter_destination_tool"
					type: "item"
				}
				{
					id: "8657A2E2C133DBED"
					type: "xp"
					xp: 600
				}
			]
			subtitle: "Speed, Redstone, Distribution and Filters"
			tasks: [{
				id: "6E91DD6F6451BB9A"
				title: "Upgrade Installed in a Pipe"
				type: "checkmark"
			}]
			title: "Q-WS03: Pipez: Upgrades and Sorting"
			x: 6.0d
			y: 0.0d
		}
		{
			description: ["&6Forgematica&r (Litematica for Forge) shows a see-through &oghost&r of a build right in the world, so you can copy it block by block. It only runs on your own game.", "", "&eM&r opens the main menu. &eM + C&r opens the settings.", "", "&6Getting blueprints:&r schematic files end in &e.litematic&r. Put them in your Prism instance's &eminecraft/schematics&r folder (Prism: right-click the instance, &eFolder&r).", "&6Saving your own:&r hold a &eStick&r (the Forgematica tool). Hold &eCtrl and scroll&r to switch to &eArea Selection&r mode, &eleft-click&r one corner and &eright-click&r the opposite corner, then press &eCtrl + Alt + S&r to save it.", "", "The pack already includes the &eHallowstown&r blueprints (house, tavern, pantry, cemetery) in &eschematics/Hallowstown&r.", "Swap .litematic files with friends to share town plans!"]
			icon: "minecraft:map"
			id: "678B09C87C6DCA51"
			rewards: [
				{
					count: 32
					id: "48EB04DC5294581A"
					item: "minecraft:scaffolding"
					type: "item"
				}
				{
					id: "569A698711EC10C7"
					type: "xp"
					xp: 300
				}
			]
			size: 1.5d
			subtitle: "Ghost Blueprints for Big Builds"
			tasks: [{
				id: "DCF095DACBE88A55"
				title: "Opened the Forgematica Menu (M)"
				type: "checkmark"
			}]
			title: "Q-WS04: Forgematica: The Blueprint Table"
			x: 0.0d
			y: 3.0d
		}
		{
			dependencies: ["678B09C87C6DCA51"]
			description: ["&e1.&r Press &eM&r, choose &eLoad Schematics&r, pick your file and click &eLoad Schematic&r. Leave &eCreate placement&r ticked: the ghost appears where you stand.", "&e2.&r Line it up. Press &eM + P&r (Schematic Placements) and click &eConfigure&r (or press &eNumpad -&r) to type exact X / Y / Z, &erotate&r and &emirror&r it.", "&e3.&r For small nudges, hold the Stick in &eSchematic Placement&r mode (Ctrl + scroll) and use &eAlt + scroll&r to slide it the way you are looking.", "", "&eM + G&r hides or shows the ghost. &eM + R&r turns all Forgematica rendering on or off."]
			icon: "minecraft:spyglass"
			id: "16EFDAC28ABD75DA"
			rewards: [
				{
					id: "5F879F2EC07E612C"
					type: "xp"
					xp: 400
				}
			]
			subtitle: "Loading and Placing a Blueprint"
			tasks: [{
				id: "6C4210BD25F9136A"
				title: "Blueprint Placed in the World"
				type: "checkmark"
			}]
			title: "Q-WS05: Forgematica: Raising the Ghost"
			x: 3.0d
			y: 3.0d
		}
		{
			dependencies: ["16EFDAC28ABD75DA"]
			description: ["Big builds go fastest if you frame them first: corners, floor and outline, then fill in.", "", "&ePage Up / Page Down&r steps the ghost through one layer at a time. &eM + Page Up&r changes the layer mode (all layers, a single layer, everything below...). Work one layer at a time so the ghost doesn't hide what you're doing.", "&eM + L&r opens the &eMaterial List&r: every block you need and how many you're short. It can stay on screen while you gather.", "&eM + V&r opens the &eSchematic Verifier&r: it highlights missing, extra and wrong blocks so nothing is left out."]
			icon: "minecraft:scaffolding"
			id: "D508421D0238C1A9"
			rewards: [
				{
					count: 32
					id: "4EA0C37352431964"
					item: "minecraft:scaffolding"
					type: "item"
				}
				{
					count: 4
