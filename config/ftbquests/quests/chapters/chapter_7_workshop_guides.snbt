		}
		{
			dependencies: ["3132DB5B5770DA53"]
			description: ["&e1.&r Put a &eStockpot&r on a lit stove.", "&e2.&r Add a &esoup base&r first (a Water Bucket for most soups).", "&e3.&r Add the ingredients, then cover it with a &eStockpot Lid&r and wait.", "&e4.&r Take the lid off and serve into a &eBowl&r.", "", "Opening the lid early pauses cooking, and wrong steps give you &osuspicious stew&r. Check JEI (press &eU&r on a soup) for exact recipes."]
			icon: "kaleidoscope_cookery:stockpot"
