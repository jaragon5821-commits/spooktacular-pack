					type: "item"
				}
				{
					id: "E7A2688CB75DA3F6"
					type: "xp"
					xp: 500
				}
			]
			subtitle: "Layer by Layer, Nothing Missed"
			tasks: [{
				id: "ECDF0CB1EB193E1A"
				title: "Checked the Material List (M + L)"
				type: "checkmark"
			}]
			title: "Q-WS06: Forgematica: Building the Framework"
			x: 6.0d
			y: 3.0d
		}
		{
			dependencies: ["D508421D0238C1A9"]
			description: ["&6Easy Place mode&r makes every right-click land exactly where the blueprint wants a block, already facing the right way (stairs, logs, doors...).", "", "&6Turn it on:&r &eM + C&r → &eGeneric&r → set &eeasyPlaceMode&r to true.", "&6Make a toggle key:&r &eM + C&r → &eHotkeys&r → &eeasyPlaceToggle&r has no key yet. Bind one you don't use, so you can flip it on and off quickly.", "", "With it on, hold the right block and &eright-click the ghost block&r. Turn it &coff&r again for normal building, or clicks will snap to the blueprint."]
			icon: "minecraft:lever"
			id: "94AD64F5668A70D1"
			rewards: [
				{
					id: "F0D64D6B7A546BD5"
					type: "xp"
					xp: 500
				}
			]
			subtitle: "Click the Ghost, Get the Right Block"
			tasks: [{
				id: "77B19A5E5E56B83C"
				title: "Easy Place Mode Set Up"
				type: "checkmark"
			}]
			title: "Q-WS07: Forgematica: Easy Place Toggle"
			x: 9.0d
			y: 3.0d
		}
		{
			dependencies: ["94AD64F5668A70D1"]
			description: ["Put &6Easy Place&r to work on a real blueprint: the pack ships ready-made &eHallowstown&r builds.", "", "&eM&r → &eLoad Schematics&r → &eHallowstown&r. The &e_modded&r builds use the pack's blocks; the &eVanilla&r folder uses plain blocks. Start small with the &ePumpkin Cottage&r.", "&eM + L&r opens the &6Material List&r: it shows every block the build needs and how many you already carry.", "With Easy Place on, hold the right block and &eright-click the ghost&r. Each block lands already facing the right way. Hold right-click and sweep across the ghost to place several in a row.", "&ePage Up / Page Down&r shows one layer at a time, so you can build bottom up.", "", "Finished? &eM + V&r opens the &6Verifier&r, which highlights any missing or wrong blocks."]
			icon: "minecraft:spyglass"
			id: "548C0B9E5ACB6473"
			rewards: [
